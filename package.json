{
  "name": "@civ-clone/base-spaceship",
  "version": "0.0.0",
  "description": "Spaceship mechanics for a rule set to use: losing a ship with its capital or its civilization, a ship for a civilization that joins late, stopping parts for a ship in flight, and the first ship to arrive landing.",
  "repository": "git@github.com:civ-clone/base-spaceship.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-game-year": "^0.1.6",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-turn-based-game": "^0.1.10",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-city": "^0.1.25",
    "@civ-clone/core-city-build": "^0.1.23",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-spaceship": "^0.1.10"
  }
}
